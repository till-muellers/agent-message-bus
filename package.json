{
	"name": "@till-muellers/omp-agent-message-bus",
	"version": "0.3.0",
	"description": "omp plugin for agent-message-bus: bus_* tools, /bus command and inbox streaming for multi-agent coordination",
	"type": "module",
	"license": "MIT",
	"author": "Till Müllers",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/till-muellers/agent-message-bus.git"
	},
	"homepage": "https://github.com/till-muellers/agent-message-bus#readme",
	"bugs": {
		"url": "https://github.com/till-muellers/agent-message-bus/issues"
	},
	"keywords": [
		"omp",
		"omp-plugin",
		"agent",
		"mcp",
		"message-bus"
	],
	"omp": {
		"extensions": [
			"./extension/index.ts"
		]
	},
	"files": [
		"extension",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "bun test tests/",
		"typecheck": "tsc --noEmit",
		"test:gui": "bun test --cwd gui",
		"build:gui": "bun run --cwd gui build"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "^18.12.6",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
